---
import Layout from "../layouts/Layout.astro";

const interestOptions = [
  { name: "Gaming", icon: "🎮" },
  { name: "Music", icon: "🎵" },
  { name: "Books", icon: "📚" },
  { name: "Fitness", icon: "🏋️" },
  { name: "Travel", icon: "✈️" },
  { name: "Movies", icon: "🎬" },
  { name: "Art", icon: "🎨" },
  { name: "Stargazing", icon: "🌌" }
];
---

<Layout title="Create Account — AnonHearts Anonymous Dating">
  <main class="flex-1 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg space-y-8">
      
      <!-- Logo Header -->
      <div class="text-center space-y-3">
        <a href="/" class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-pink-600 to-rose-400 text-3xl shadow-xl shadow-pink-500/20 hover:scale-105 transition">
          ❤️
        </a>
        <h1 class="text-3xl font-extrabold tracking-tight text-white">Create Account</h1>
        <p class="text-zinc-400 text-sm">
          Start meeting new people anonymously with full privacy protection
        </p>
      </div>

      <!-- Signup Card -->
      <div class="rounded-3xl border border-zinc-800/80 bg-zinc-950/80 p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-6">

        <form id="signup-form" novalidate class="space-y-5">

          <!-- Nickname -->
          <div class="space-y-2">
            <label for="nickname" class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider">
              Anonymous Nickname
            </label>
            <input
              id="nickname"
              name="nickname"
              type="text"
              placeholder="e.g. MysteryHeart"
              maxlength="30"
              class="w-full rounded-2xl border border-zinc-700/80 bg-black/60 px-4 py-3 text-white placeholder-zinc-500 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-500/20 transition text-sm"
            />
          </div>

          <!-- Email -->
          <div class="space-y-2">
            <label for="email" class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider">
              Email Address
            </label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              class="w-full rounded-2xl border border-zinc-700/80 bg-black/60 px-4 py-3 text-white placeholder-zinc-500 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-500/20 transition text-sm"
            />
          </div>

          <!-- Password & Age Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <div class="space-y-2">
              <label for="password" class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider">
                Password
              </label>
              <input
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                class="w-full rounded-2xl border border-zinc-700/80 bg-black/60 px-4 py-3 text-white placeholder-zinc-500 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-500/20 transition text-sm"
              />
            </div>

            <div class="space-y-2">
              <label for="age" class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider">
                Age
              </label>
              <input
                id="age"
                name="age"
                type="number"
                placeholder="21"
                class="w-full rounded-2xl border border-zinc-700/80 bg-black/60 px-4 py-3 text-white placeholder-zinc-500 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-500/20 transition text-sm"
              />
            </div>

          </div>

          <!-- Interests Selection -->
          <div class="space-y-3">
            <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider">
              Pick Top Passions
            </label>
            <div class="flex flex-wrap gap-2">
              {interestOptions.map((item) => (
                <button
                  type="button"
                  class="interest-btn flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-zinc-800 bg-zinc-900/80 text-zinc-300 text-xs font-medium transition hover:border-pink-500/50 hover:bg-zinc-800"
                  data-interest={item.name}
                >
                  <span>{item.icon}</span>
                  <span>{item.name}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Error Message Display -->
          <div id="error-message" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-3.5 text-xs text-red-400"></div>

          <!-- Submit Button -->
          <button
            id="submit-button"
            type="submit"
            class="w-full py-4 rounded-full bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-bold text-sm shadow-xl shadow-pink-600/20 transition hover:scale-[1.01] active:scale-[0.99]"
          >
            Create Account & Join ❤️
          </button>
        </form>

        <!-- Direct Skip / Instant Access Button -->
        <a
          href="/profile"
          id="direct-join-link"
          class="block w-full text-center py-3 rounded-full border border-zinc-800 bg-zinc-900/90 text-zinc-300 hover:text-white hover:bg-zinc-800 text-xs font-semibold transition"
        >
          ⚡ Instant Access (Skip Form & Customize Profile)
        </a>

        <p class="text-center text-xs text-zinc-400 pt-2">
          Already have an account?
          <a href="/login" class="text-pink-400 font-semibold hover:underline">Log in</a>
        </p>

      </div>

    </div>
  </main>

  <script>
    import { supabase } from "../lib/supabase";

    const selectedInterests = new Set<string>(["Gaming", "Music"]);
    const interestBtns = document.querySelectorAll(".interest-btn");

    interestBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const name = (btn as HTMLElement).dataset.interest;
        if (!name) return;

        if (selectedInterests.has(name)) {
          selectedInterests.delete(name);
          btn.classList.remove("border-pink-500", "bg-pink-500/20", "text-pink-300");
        } else {
          selectedInterests.add(name);
          btn.classList.add("border-pink-500", "bg-pink-500/20", "text-pink-300");
        }
      });
    });

    const form = document.querySelector("#signup-form") as HTMLFormElement;
    const submitBtn = document.querySelector("#submit-button") as HTMLButtonElement;
    const directJoinLink = document.querySelector("#direct-join-link") as HTMLAnchorElement;

    function createAndRedirect(rawNickname?: string, rawEmail?: string) {
      const timestamp = Date.now();
      const nickname = rawNickname?.trim() || `MysteryHeart_${Math.floor(Math.random() * 900 + 100)}`;
      const email = rawEmail?.trim() || `user_${timestamp}@anonhearts.com`;

      const userProfile = {
        nickname,
        age: 21,
        interests: Array.from(selectedInterests),
        avatar: "🦊",
        bio: "Excited to meet new people anonymously!"
      };

      // 1. Instantly save session state
      localStorage.setItem("anonhearts_user", JSON.stringify({
        id: "user_" + timestamp,
        email,
        nickname,
        loggedIn: true
      }));

      localStorage.setItem("anonhearts_profile", JSON.stringify(userProfile));

      // 2. Fire Supabase signup asynchronously
      try {
        supabase.auth.signUp({
          email,
          password: "Password123!",
          options: { data: userProfile }
        }).catch(err => console.warn("Supabase async:", err));
      } catch (e) {
        console.warn("Supabase sync:", e);
      }

      // 3. Navigate immediately
      window.location.href = "/profile";
    }

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Creating profile...";
      }

      const nicknameInput = (document.querySelector("#nickname") as HTMLInputElement)?.value;
      const emailInput = (document.querySelector("#email") as HTMLInputElement)?.value;

      createAndRedirect(nicknameInput, emailInput);
    });

    directJoinLink?.addEventListener("click", () => {
      createAndRedirect();
    });
  </script>
</Layout>