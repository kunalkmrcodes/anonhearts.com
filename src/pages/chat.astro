---
import Layout from "../layouts/Layout.astro";

const icebreakers = [
  "What's a secret habit or hobby you rarely tell anyone about? 🤫",
  "If you could teleport to any city right now for dinner, where would we go? ✈️",
  "What song have you had on repeat for the past week? 🎵",
  "Are you a late-night deep talker or an early-morning coffee person? ☕"
];
---

<Layout title="Anonymous Chat Room — AnonHearts">
  <main class="max-w-5xl mx-auto px-2 sm:px-4 py-2 sm:py-4 flex-1 flex flex-col h-[calc(100dvh-4.5rem)] min-h-[450px]">

    <!-- CHAT CONTAINER CARD -->
    <div class="flex-1 rounded-2xl sm:rounded-3xl border border-zinc-800/80 bg-zinc-950/90 shadow-2xl flex flex-col overflow-hidden backdrop-blur-xl">

      <!-- CHAT HEADER -->
      <div class="px-3 sm:px-6 py-2.5 sm:py-3.5 border-b border-zinc-800/80 bg-zinc-900/60 flex items-center justify-between gap-2">
        
        <!-- Left: Match Profile Info -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a href="/matches" class="text-zinc-400 hover:text-white p-1 text-base sm:text-lg" title="Back to matches">
            ←
          </a>

          <div class="relative">
            <div id="chat-avatar" class="w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-gradient-to-tr from-pink-600 to-purple-800 flex items-center justify-center text-lg sm:text-2xl border border-pink-500/40 shadow-md">
              🦊
            </div>
            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-zinc-950"></span>
          </div>

          <div class="min-w-0">
            <div class="flex items-center gap-1 sm:gap-1.5">
              <h2 id="chat-nickname" class="font-extrabold text-xs sm:text-base text-white truncate max-w-[90px] sm:max-w-none">VelvetEcho</h2>
              <span class="text-[9px] bg-pink-500/20 text-pink-300 px-1.5 py-0.5 rounded-full font-semibold border border-pink-500/30 hidden xs:inline-block">
                Match
              </span>
            </div>
            <p id="chat-status" class="text-[10px] sm:text-xs text-zinc-400 truncate">Online • Active</p>
          </div>
        </div>

        <!-- Center/Right: Reveal Progress Bar (Visible on all screens) -->
        <div class="flex items-center gap-2 sm:gap-4">
          <div class="flex flex-col items-end w-24 sm:w-36 space-y-0.5 sm:space-y-1">
            <div class="flex items-center gap-1 text-[10px] sm:text-xs font-semibold text-zinc-300">
              <span class="hidden sm:inline">Reveal Gauge</span>
              <span id="reveal-percent" class="text-pink-400 font-bold">35%</span>
            </div>
            <div class="w-full bg-zinc-800 h-1.5 sm:h-2 rounded-full overflow-hidden">
              <div id="reveal-bar-inner" class="bg-gradient-to-r from-pink-500 to-rose-400 h-full rounded-full transition-all duration-500" style="width: 35%;"></div>
            </div>
          </div>

          <!-- Basketball Game Trigger Button -->
          <button
            id="play-basketball-btn"
            type="button"
            class="px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-full border border-amber-500/40 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-bold transition flex items-center gap-1 shadow-md shadow-amber-500/10 active:scale-95 cursor-pointer shrink-0"
            title="Play Level-Based Basketball Shootout"
          >
            <span class="text-sm">🏀</span>
            <span class="hidden md:inline">Shootout</span>
          </button>

          <!-- Reveal Request Button -->
          <button
            id="reveal-request-btn"
            type="button"
            class="px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-full border border-pink-500/40 bg-pink-500/10 hover:bg-pink-500/20 text-pink-300 text-xs font-bold transition flex items-center gap-1 active:scale-95 cursor-pointer shrink-0"
            title="Request Photo Unmask"
          >
            <span>🔓</span>
            <span class="hidden md:inline">Unmask</span>
          </button>
        </div>

      </div>

      <!-- ICEBREAKER BANNER BAR -->
      <div class="px-3 py-1.5 bg-pink-950/30 border-b border-pink-500/20 flex items-center justify-between gap-2 overflow-x-auto no-scrollbar">
        <span class="text-[10px] sm:text-[11px] font-semibold text-pink-400 shrink-0 flex items-center gap-1">
          <span>⚡ Icebreakers:</span>
        </span>
        <div class="flex items-center gap-1.5 shrink-0">
          {icebreakers.map((ib) => (
            <button
              type="button"
              class="icebreaker-btn text-[10px] sm:text-[11px] px-2.5 py-0.5 sm:py-1 rounded-full bg-zinc-900/90 border border-zinc-700/80 text-zinc-300 hover:border-pink-500/60 hover:text-pink-300 transition whitespace-nowrap"
              data-text={ib}
            >
              {ib}
            </button>
          ))}
        </div>
      </div>

      <!-- MESSAGES FEED AREA -->
      <div id="chat-feed" class="flex-1 p-3 sm:p-6 overflow-y-auto space-y-3.5 font-sans text-xs sm:text-sm">
        
        <!-- System Welcome Note -->
        <div class="text-center py-1">
          <span class="inline-block px-3 py-1 rounded-full bg-zinc-900/80 border border-zinc-800 text-[10px] sm:text-[11px] text-zinc-400">
            🔒 Encrypted anonymous session. Reveal gauge advances with every message & game played!
          </span>
        </div>

        <!-- Initial Incoming Message -->
        <div class="flex items-end gap-2 max-w-[88%] sm:max-w-[75%]">
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-tr from-pink-600 to-purple-800 flex items-center justify-center text-xs sm:text-sm shrink-0">
            🦊
          </div>
          <div class="space-y-1">
            <div class="bg-zinc-900 border border-zinc-800 p-3 sm:p-3.5 rounded-2xl rounded-bl-sm text-zinc-200 shadow-md">
              Hey there! 👋 Challenge me in the Basketball Shootout! Click 🏀 Shootout to beat Level 1 to 5!
            </div>
            <div class="text-[9px] sm:text-[10px] text-zinc-500 px-1">10:42 PM</div>
          </div>
        </div>

        <!-- Outgoing Message -->
        <div class="flex items-end justify-end gap-2 max-w-[88%] sm:max-w-[75%] ml-auto">
          <div class="space-y-1 text-right">
            <div class="bg-gradient-to-r from-pink-600 to-rose-600 text-white p-3 sm:p-3.5 rounded-2xl rounded-br-sm shadow-md shadow-pink-600/10">
              Challenge accepted! Let's see who reaches Level 5 Legend status 🏀
            </div>
            <div class="text-[9px] sm:text-[10px] text-zinc-500 px-1">10:44 PM • Sent</div>
          </div>
        </div>

        <!-- Typing Indicator -->
        <div id="typing-indicator" class="hidden flex items-center gap-2 text-xs text-zinc-400 pl-8 sm:pl-10">
          <span class="animate-bounce font-bold text-pink-400">•</span>
          <span class="animate-bounce delay-100 font-bold text-pink-400">•</span>
          <span class="animate-bounce delay-200 font-bold text-pink-400">•</span>
          <span class="italic">VelvetEcho is typing...</span>
        </div>

      </div>

      <!-- MOBILE RESPONSIVE CHAT INPUT FORM -->
      <div class="p-2 sm:p-3 border-t border-zinc-800/80 bg-zinc-900/40 flex items-center gap-1.5 sm:gap-2">
        <button
          id="bar-basketball-btn"
          type="button"
          class="p-2.5 sm:p-3 rounded-xl sm:rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 hover:bg-amber-500/20 transition flex items-center gap-1 text-xs font-bold shrink-0 cursor-pointer"
          title="Play Basketball Shootout"
        >
          <span class="text-base sm:text-sm">🏀</span>
          <span class="hidden sm:inline">Shootout</span>
        </button>

        <form id="chat-form" class="flex-1 flex items-center gap-1.5 sm:gap-2">
          <input
            id="message-input"
            type="text"
            placeholder="Type anonymous message..."
            autocomplete="off"
            required
            class="flex-1 rounded-xl sm:rounded-2xl border border-zinc-700/80 bg-black/60 px-3 sm:px-4 py-2.5 sm:py-3 text-white placeholder-zinc-500 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-500/20 transition text-xs sm:text-sm"
          />

          <button
            type="submit"
            class="px-3.5 sm:px-5 py-2.5 sm:py-3 rounded-xl sm:rounded-2xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-pink-600/20 transition hover:scale-105 active:scale-95 flex items-center gap-1 cursor-pointer shrink-0"
          >
            <span class="hidden xs:inline">Send</span>
            <span>🚀</span>
          </button>
        </form>
      </div>

    </div>

    <!-- REVEAL PHOTO CONFIRMATION MODAL -->
    <div id="reveal-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xl">
      <div class="w-full max-w-md rounded-3xl border border-pink-500/40 bg-zinc-950 p-6 sm:p-8 text-center space-y-5 shadow-2xl">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-pink-500/20 border border-pink-500/40 text-2xl">
          🔓
        </div>
        <div class="space-y-1.5">
          <h3 class="text-xl sm:text-2xl font-bold text-white">Mutual Unmask Request</h3>
          <p class="text-xs text-zinc-400">
            You are sending a request to <span class="text-pink-400 font-bold">VelvetEcho</span> to mutually reveal real profile photos.
          </p>
        </div>

        <div class="space-y-2.5 pt-2">
          <button
            id="confirm-reveal-btn"
            type="button"
            class="w-full py-3 rounded-full bg-gradient-to-r from-pink-600 to-rose-600 text-white font-bold text-sm shadow-lg shadow-pink-500/30 cursor-pointer"
          >
            Send Unmask Request ❤️
          </button>
          <button
            id="cancel-reveal-btn"
            type="button"
            class="w-full py-2 text-xs text-zinc-500 hover:text-zinc-300 cursor-pointer"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>

    <!-- MOBILE-OPTIMIZED BASKETBALL MINI-GAME MODAL -->
    <div id="basketball-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/90 backdrop-blur-2xl overflow-y-auto">
      <div class="relative w-full max-w-md sm:max-w-lg max-h-[95vh] rounded-3xl border border-amber-500/40 bg-zinc-950 p-4 sm:p-6 text-center space-y-3 shadow-2xl shadow-amber-500/10 overflow-y-auto">
        
        <!-- Close Button -->
        <button
          id="close-basketball-btn"
          type="button"
          class="absolute top-3 right-3 text-zinc-400 hover:text-white p-1 text-xl z-30 cursor-pointer"
        >
          ✖
        </button>

        <!-- Header Scoreboard & Level Pills -->
        <div class="space-y-1.5 pt-1">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[11px] font-bold">
            🏀 Match Shootout Challenge
          </div>

          <!-- Level Selector Pills -->
          <div class="flex items-center justify-center gap-1 pt-1 flex-wrap">
            {[1, 2, 3, 4, 5].map((lvl) => (
              <button
                type="button"
                class={`level-pill-btn px-2.5 py-0.5 rounded-full text-[11px] font-extrabold transition cursor-pointer ${
                  lvl === 1
                    ? "bg-amber-500 text-black shadow-md shadow-amber-500/30"
                    : "bg-zinc-900 text-zinc-400 border border-zinc-800 hover:border-zinc-700"
                }`}
                data-level={lvl}
              >
                Lvl {lvl}
              </button>
            ))}
          </div>

          <!-- Active Level Banner Description -->
          <div id="level-desc-banner" class="text-[11px] font-semibold text-amber-300 bg-amber-950/40 py-1 px-2.5 rounded-xl border border-amber-500/20 truncate">
            🔥 Level 1: Rookie Court (Fixed Rim • Target: 3)
          </div>
        </div>

        <!-- Score, Streak & Timer Bar -->
        <div class="flex items-center justify-between px-3 py-1.5 bg-zinc-900/80 rounded-2xl border border-zinc-800 text-[11px] font-bold text-zinc-200">
          <div class="flex items-center gap-1">
            <span class="text-amber-400">Score:</span>
            <span id="game-score" class="text-sm text-white font-extrabold">0</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="text-pink-400">Streak:</span>
            <span id="game-streak" class="text-sm text-white font-extrabold">0</span>
          </div>
          <div class="flex items-center gap-1 text-emerald-400">
            <span>Baskets:</span>
            <span id="game-baskets" class="font-extrabold text-white">0/3</span>
          </div>
          <div id="timer-box" class="hidden flex items-center gap-1 text-rose-400">
            <span>⏱️</span>
            <span id="timer-val" class="font-extrabold">15s</span>
          </div>
        </div>

        <!-- Basketball Court Responsive Canvas Area -->
        <div class="relative w-full h-[260px] sm:h-[300px] rounded-2xl border border-zinc-800 bg-gradient-to-b from-indigo-950/60 via-zinc-950 to-amber-950/40 overflow-hidden flex flex-col justify-between p-3 select-none touch-none">
          
          <!-- Moving Backboard & Hoop Container -->
          <div id="hoop-container" class="relative w-full h-20 flex items-center justify-center transition-all duration-300">
            <div id="hoop-assembly" class="relative flex flex-col items-center transition-all duration-300">
              <!-- Backboard -->
              <div id="backboard" class="w-20 h-14 sm:w-24 sm:h-16 rounded-xl border-3 border-white/80 bg-white/10 backdrop-blur-md flex items-center justify-center shadow-lg">
                <div class="w-8 h-6 border-2 border-red-500/80 bg-red-500/10"></div>
              </div>
              <!-- Rim & Net -->
              <div class="relative -mt-1 flex flex-col items-center">
                <div id="rim" class="w-10 h-3 sm:w-12 sm:h-3.5 rounded-full border-3 border-amber-500 bg-amber-500/20 shadow-lg shadow-amber-500/50"></div>
                <div class="w-8 h-6 border-x border-b border-dashed border-white/60 rounded-b-xl -mt-1 bg-white/5"></div>
              </div>
            </div>
          </div>

          <!-- Wind Indicator Banner -->
          <div id="wind-indicator" class="hidden absolute top-2 right-3 text-[10px] font-bold text-cyan-300 bg-cyan-950/60 px-2 py-0.5 rounded-full border border-cyan-500/30">
            💨 Wind: 8 mph Left
          </div>

          <!-- Swish Alert Overlay -->
          <div id="swish-alert" class="hidden absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2 font-extrabold text-2xl sm:text-3xl text-amber-400 animate-bounce drop-shadow-[0_0_15px_rgba(245,158,11,0.8)] z-30">
            🔥 SWISH!
          </div>

          <!-- Touch/Swipe Ball Area -->
          <div class="relative h-24 sm:h-28 flex flex-col items-center justify-end">
            <!-- Aim Trajectory Line -->
            <div id="aim-line" class="w-1 bg-gradient-to-t from-amber-500 to-transparent h-12 sm:h-16 mb-1 rounded-full opacity-70 transition-all duration-200"></div>
            
            <!-- Interactive Touch Basketball -->
            <div
              id="basketball"
              class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-gradient-to-tr from-amber-600 via-orange-500 to-amber-400 flex items-center justify-center text-xl sm:text-2xl shadow-xl shadow-amber-500/30 border-2 border-amber-300 cursor-pointer transform hover:scale-110 active:scale-95 transition-all duration-100 z-20 select-none touch-none"
            >
              🏀
            </div>
          </div>

        </div>

        <!-- Mobile Controls Toolbar -->
        <div class="flex items-center justify-between gap-2 pt-1">
          <button
            id="shoot-btn"
            type="button"
            class="flex-1 py-3 sm:py-3.5 rounded-full bg-gradient-to-r from-amber-500 via-orange-500 to-rose-600 hover:from-amber-400 hover:to-rose-500 text-white font-extrabold text-xs sm:text-sm shadow-xl shadow-amber-500/25 transition active:scale-95 cursor-pointer"
          >
            🏀 TAP OR SWIPE TO SHOOT!
          </button>
          
          <button
            id="share-score-btn"
            type="button"
            class="px-3.5 py-3 sm:py-3.5 rounded-full border border-pink-500/40 bg-pink-500/10 hover:bg-pink-500/20 text-pink-300 font-bold text-xs transition cursor-pointer shrink-0"
          >
            Post to Chat 💬
          </button>
        </div>

      </div>
    </div>

  </main>

  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const matchId = urlParams.get("matchId");

    const savedMatches = JSON.parse(localStorage.getItem("anonhearts_matches") || "[]");
    const activeMatch = savedMatches.find((m: any) => m.id === matchId) || {
      nickname: "VelvetEcho",
      avatar: "🦊",
      revealLevel: 35
    };

    const chatNickname = document.getElementById("chat-nickname");
    const chatAvatar = document.getElementById("chat-avatar");
    if (chatNickname) chatNickname.textContent = activeMatch.nickname;
    if (chatAvatar) chatAvatar.textContent = activeMatch.avatar;

    const chatFeed = document.getElementById("chat-feed");
    function appendMessage(sender: "user" | "match" | "system", text: string) {
      if (!chatFeed) return;
      const wrap = document.createElement("div");

      if (sender === "user") {
        wrap.className = "flex items-end justify-end gap-2 max-w-[88%] sm:max-w-[75%] ml-auto animate-fade-in";
        wrap.innerHTML = `
          <div class="space-y-1 text-right">
            <div class="bg-gradient-to-r from-pink-600 to-rose-600 text-white p-3 sm:p-3.5 rounded-2xl rounded-br-sm shadow-md">
              ${text}
            </div>
            <div class="text-[9px] sm:text-[10px] text-zinc-500 px-1">Just now • Sent</div>
          </div>
        `;
      } else if (sender === "match") {
        wrap.className = "flex items-end gap-2 max-w-[88%] sm:max-w-[75%] animate-fade-in";
        wrap.innerHTML = `
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-tr from-pink-600 to-purple-800 flex items-center justify-center text-xs sm:text-sm shrink-0">
            ${activeMatch.avatar}
          </div>
          <div class="space-y-1">
            <div class="bg-zinc-900 border border-zinc-800 p-3 sm:p-3.5 rounded-2xl rounded-bl-sm text-zinc-200 shadow-md">
              ${text}
            </div>
            <div class="text-[9px] sm:text-[10px] text-zinc-500 px-1">Just now</div>
          </div>
        `;
      } else {
        wrap.className = "text-center py-1.5 animate-fade-in";
        wrap.innerHTML = `
          <span class="inline-block px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-[11px] text-amber-300 font-semibold">
            ${text}
          </span>
        `;
      }

      chatFeed.appendChild(wrap);
      chatFeed.scrollTop = chatFeed.scrollHeight;
    }

    const chatForm = document.getElementById("chat-form") as HTMLFormElement;
    const messageInput = document.getElementById("message-input") as HTMLInputElement;
    const typingIndicator = document.getElementById("typing-indicator");

    chatForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = messageInput.value.trim();
      if (!text) return;

      appendMessage("user", text);
      messageInput.value = "";

      setTimeout(() => typingIndicator?.classList.remove("hidden"), 500);
      setTimeout(() => {
        typingIndicator?.classList.add("hidden");
        const replies = [
          "Nice shot! Let's conquer Level 5 together 🏀",
          "You're a basketball legend!",
          "Swish! Keep aiming high 🔥"
        ];
        appendMessage("match", replies[Math.floor(Math.random() * replies.length)]);
      }, 1800);
    });

    // MOBILE-FRIENDLY LEVEL GAME ENGINE
    let currentLevel = 1;
    let score = 0;
    let streak = 0;
    let levelBaskets = 0;
    let isShooting = false;
    let timerInterval: any = null;
    let timeLeft = 15;

    const levelConfigs: Record<number, { title: string; target: number; accuracy: number; speed: number; wind: boolean; timer: boolean }> = {
      1: { title: "Lvl 1: Rookie Court (Fixed Rim)", target: 3, accuracy: 0.85, speed: 0, wind: false, timer: false },
      2: { title: "Lvl 2: Moving Rim (Horizontal Motion)", target: 3, accuracy: 0.70, speed: 1.5, wind: false, timer: false },
      3: { title: "Lvl 3: Crosswind Challenge (Wind Drift)", target: 4, accuracy: 0.55, speed: 2.5, wind: true, timer: false },
      4: { title: "Lvl 4: Sinusoidal Orbit (Wave Motion)", target: 4, accuracy: 0.45, speed: 3.5, wind: true, timer: false },
      5: { title: "Lvl 5: Buzzer Beater Legend (15s Countdown!)", target: 5, accuracy: 0.35, speed: 4.5, wind: true, timer: true }
    };

    const basketModal = document.getElementById("basketball-modal");
    const playBasketBtn = document.getElementById("play-basketball-btn");
    const barBasketBtn = document.getElementById("bar-basketball-btn");
    const closeBasketBtn = document.getElementById("close-basketball-btn");
    const shootBtn = document.getElementById("shoot-btn");
    const basketball = document.getElementById("basketball");
    const swishAlert = document.getElementById("swish-alert");
    const shareScoreBtn = document.getElementById("share-score-btn");
    const levelDescBanner = document.getElementById("level-desc-banner");
    const windIndicator = document.getElementById("wind-indicator");

    const gameScoreEl = document.getElementById("game-score");
    const gameStreakEl = document.getElementById("game-streak");
    const gameBasketsEl = document.getElementById("game-baskets");
    const timerBox = document.getElementById("timer-box");
    const timerVal = document.getElementById("timer-val");

    const hoopAssembly = document.getElementById("hoop-assembly");
    const levelPillBtns = document.querySelectorAll(".level-pill-btn");

    function setLevel(lvl: number) {
      currentLevel = lvl;
      levelBaskets = 0;
      const config = levelConfigs[lvl];

      if (levelDescBanner) levelDescBanner.textContent = config.title;
      if (gameBasketsEl) gameBasketsEl.textContent = `0/${config.target}`;

      levelPillBtns.forEach((btn) => {
        const l = Number((btn as HTMLElement).dataset.level);
        if (l === lvl) {
          btn.className = "level-pill-btn px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-amber-500 text-black shadow-md shadow-amber-500/30 cursor-pointer";
        } else {
          btn.className = "level-pill-btn px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-zinc-900 text-zinc-400 border border-zinc-800 cursor-pointer hover:border-zinc-700";
        }
      });

      if (config.wind && windIndicator) {
        windIndicator.classList.remove("hidden");
        windIndicator.textContent = `💨 Wind: ${Math.floor(Math.random() * 8 + 4)} mph Left`;
      } else {
        windIndicator?.classList.add("hidden");
      }

      if (config.timer && timerBox) {
        timerBox.classList.remove("hidden");
        startTimer();
      } else {
        timerBox?.classList.add("hidden");
        clearInterval(timerInterval);
      }

      if (hoopAssembly) {
        hoopAssembly.style.animation = config.speed > 0 ? `slideHoopMobile ${4 / config.speed}s ease-in-out infinite alternate` : "none";
      }
    }

    function startTimer() {
      clearInterval(timerInterval);
      timeLeft = 15;
      if (timerVal) timerVal.textContent = `${timeLeft}s`;

      timerInterval = setInterval(() => {
        timeLeft--;
        if (timerVal) timerVal.textContent = `${timeLeft}s`;
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          alert("⏱️ Time's Up on Level 5! Try again!");
          setLevel(5);
        }
      }, 1000);
    }

    function shootBall() {
      if (isShooting || !basketball) return;
      isShooting = true;

      const config = levelConfigs[currentLevel];
      basketball.style.transform = "translateY(-170px) scale(0.6)";

      const isSuccess = Math.random() < config.accuracy;

      setTimeout(() => {
        if (isSuccess) {
          score += (currentLevel * 10);
          streak++;
          levelBaskets++;

          if (swishAlert) {
            swishAlert.textContent = `🔥 Lvl ${currentLevel} SWISH!`;
            swishAlert.classList.remove("hidden");
            setTimeout(() => swishAlert.classList.add("hidden"), 900);
          }

          if (levelBaskets >= config.target) {
            setTimeout(() => {
              if (currentLevel < 5) {
                alert(`🏆 LEVEL ${currentLevel} CONQUERED! Unlocking Level ${currentLevel + 1}! 🎉`);
                setLevel(currentLevel + 1);
              } else {
                alert("🏆 ALL 5 BASKETBALL LEVELS CONQUERED! LEGEND STATUS UNLOCKED! 🔥");
              }
            }, 300);
          }
        } else {
          streak = 0;
          basketball.style.transform = "translateY(-130px) translateX(35px) scale(0.5)";
        }

        if (gameScoreEl) gameScoreEl.textContent = String(score);
        if (gameStreakEl) gameStreakEl.textContent = String(streak);
        if (gameBasketsEl) gameBasketsEl.textContent = `${levelBaskets}/${config.target}`;

        setTimeout(() => {
          basketball.style.transform = "translateY(0) scale(1)";
          isShooting = false;
        }, 400);

      }, 400);
    }

    // Touch Swipe Gesture for Mobile
    let touchStartY = 0;
    basketball?.addEventListener("touchstart", (e) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    basketball?.addEventListener("touchend", (e) => {
      const touchEndY = e.changedTouches[0].clientY;
      if (touchStartY - touchEndY > 30) {
        shootBall();
      }
    }, { passive: true });

    // Click handlers
    levelPillBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const lvl = Number((btn as HTMLElement).dataset.level);
        if (lvl) setLevel(lvl);
      });
    });

    playBasketBtn?.addEventListener("click", () => {
      basketModal?.classList.remove("hidden");
      setLevel(1);
    });
    barBasketBtn?.addEventListener("click", () => {
      basketModal?.classList.remove("hidden");
      setLevel(1);
    });
    closeBasketBtn?.addEventListener("click", () => {
      basketModal?.classList.add("hidden");
      clearInterval(timerInterval);
    });

    shootBtn?.addEventListener("click", shootBall);
    basketball?.addEventListener("click", shootBall);

    shareScoreBtn?.addEventListener("click", () => {
      basketModal?.classList.add("hidden");
      clearInterval(timerInterval);
      const scoreMsg = `🏀 Level ${currentLevel} Shootout Victory: Scored ${levelBaskets} Baskets (Total Points: ${score} pts) 🔥`;
      appendMessage("system", scoreMsg);
      setTimeout(() => {
        appendMessage("match", `Incredible score on Level ${currentLevel}! Let's play Level ${Math.min(5, currentLevel + 1)} next! 🏆`);
      }, 1200);
    });
  </script>
</Layout>

<style>
  @keyframes slideHoopMobile {
    0% { transform: translateX(-65px); }
    100% { transform: translateX(65px); }
  }
</style>
