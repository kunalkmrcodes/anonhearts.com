---
import Layout from "../layouts/Layout.astro";

const icebreakers = [
  "What's a secret habit or hobby you rarely tell anyone about? 🤫",
  "If you could teleport to any city right now for dinner, where would we go? ✈️",
  "What song have you had on repeat for the past week? 🎵",
  "Are you a late-night deep talker or an early-morning coffee person? ☕"
];
---

<Layout title="Anonymous Chat Room — AnonHearts">
  <main class="max-w-5xl mx-auto px-2 sm:px-4 py-4 flex-1 flex flex-col h-[calc(100vh-5rem)]">

    <!-- CHAT CONTAINER CARD -->
    <div class="flex-1 rounded-3xl border border-zinc-800/80 bg-zinc-950/90 shadow-2xl flex flex-col overflow-hidden backdrop-blur-xl">

      <!-- CHAT HEADER -->
      <div class="px-4 sm:px-6 py-3.5 border-b border-zinc-800/80 bg-zinc-900/60 flex items-center justify-between gap-3">
        
        <!-- Left: Match Profile Info -->
        <div class="flex items-center gap-3">
          <a href="/matches" class="text-zinc-400 hover:text-white p-1 text-lg" title="Back to matches">
            ←
          </a>

          <div class="relative">
            <div id="chat-avatar" class="w-11 h-11 rounded-full bg-gradient-to-tr from-pink-600 to-purple-800 flex items-center justify-center text-2xl border border-pink-500/40 shadow-md">
              🦊
            </div>
            <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 rounded-full border-2 border-zinc-950"></span>
          </div>

          <div>
            <div class="flex items-center gap-2">
              <h2 id="chat-nickname" class="font-extrabold text-base text-white">VelvetEcho</h2>
              <span class="text-[10px] bg-pink-500/20 text-pink-300 px-2 py-0.5 rounded-full font-semibold border border-pink-500/30">
                Anonymous Match
              </span>
            </div>
            <p id="chat-status" class="text-xs text-zinc-400">Online • Active now</p>
          </div>
        </div>

        <!-- Right: Action Toolbar -->
        <div class="flex items-center gap-2.5">
          <!-- Basketball Game Trigger Button -->
          <button
            id="play-basketball-btn"
            type="button"
            class="px-3.5 py-2 rounded-full border border-amber-500/40 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-bold transition flex items-center gap-1.5 shadow-md shadow-amber-500/10 active:scale-95 cursor-pointer"
            title="Play Level-Based Basketball Shootout"
          >
            <span class="text-base">🏀</span>
            <span class="hidden sm:inline">Play Shootout</span>
          </button>

          <!-- Reveal Request Button -->
          <button
            id="reveal-request-btn"
            type="button"
            class="px-3.5 py-2 rounded-full border border-pink-500/40 bg-pink-500/10 hover:bg-pink-500/20 text-pink-300 text-xs font-bold transition flex items-center gap-1.5 active:scale-95 cursor-pointer"
          >
            <span>🔓</span>
            <span class="hidden sm:inline">Photo Unmask</span>
          </button>
        </div>

      </div>

      <!-- ICEBREAKER BANNER BAR -->
      <div class="px-4 py-2 bg-pink-950/30 border-b border-pink-500/20 flex items-center justify-between gap-2 overflow-x-auto no-scrollbar">
        <span class="text-xs font-semibold text-pink-400 shrink-0 flex items-center gap-1">
          <span>⚡ Spark Icebreaker:</span>
        </span>
        <div class="flex items-center gap-2 shrink-0">
          {icebreakers.map((ib) => (
            <button
              type="button"
              class="icebreaker-btn text-[11px] px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-700/80 text-zinc-300 hover:border-pink-500/60 hover:text-pink-300 transition whitespace-nowrap"
              data-text={ib}
            >
              {ib}
            </button>
          ))}
        </div>
      </div>

      <!-- MESSAGES FEED AREA -->
      <div id="chat-feed" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 font-sans text-sm">
        
        <!-- System Welcome Note -->
        <div class="text-center py-2">
          <span class="inline-block px-4 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs text-zinc-400">
            🔒 End-to-end encrypted anonymous session. Reveal gauge advances with every message & game played!
          </span>
        </div>

        <!-- Initial Incoming Message -->
        <div class="flex items-end gap-2.5 max-w-[85%] sm:max-w-[70%]">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-pink-600 to-purple-800 flex items-center justify-center text-sm shrink-0">
            🦊
          </div>
          <div class="space-y-1">
            <div class="bg-zinc-900 border border-zinc-800 p-3.5 rounded-2xl rounded-bl-sm text-zinc-200 shadow-md">
              Hey there! 👋 Challenge me in the Basketball Shootout! Click 🏀 Play Shootout to beat Level 1 to 5!
            </div>
            <div class="text-[10px] text-zinc-500 px-1">10:42 PM</div>
          </div>
        </div>

        <!-- Outgoing Message -->
        <div class="flex items-end justify-end gap-2.5 max-w-[85%] sm:max-w-[70%] ml-auto">
          <div class="space-y-1 text-right">
            <div class="bg-gradient-to-r from-pink-600 to-rose-600 text-white p-3.5 rounded-2xl rounded-br-sm shadow-md shadow-pink-600/10">
              Challenge accepted! Let's see who reaches Level 5 Legend status 🏀
            </div>
            <div class="text-[10px] text-zinc-500 px-1">10:44 PM • Sent</div>
          </div>
        </div>

        <!-- Typing Indicator -->
        <div id="typing-indicator" class="hidden flex items-center gap-2 text-xs text-zinc-400 pl-10">
          <span class="animate-bounce font-bold text-pink-400">•</span>
          <span class="animate-bounce delay-100 font-bold text-pink-400">•</span>
          <span class="animate-bounce delay-200 font-bold text-pink-400">•</span>
          <span class="italic">VelvetEcho is typing...</span>
        </div>

      </div>

      <!-- CHAT INPUT FORM -->
      <div class="p-3 sm:p-4 border-t border-zinc-800/80 bg-zinc-900/40 flex items-center gap-2">
        <button
          id="bar-basketball-btn"
          type="button"
          class="p-3 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 hover:bg-amber-500/20 transition flex items-center gap-1.5 text-xs font-bold shrink-0 cursor-pointer"
          title="Play Basketball Shootout"
        >
          <span>🏀 Shootout</span>
        </button>

        <form id="chat-form" class="flex-1 flex items-center gap-2">
          <input
            id="message-input"
            type="text"
            placeholder="Type your anonymous message..."
            autocomplete="off"
            required
            class="flex-1 rounded-2xl border border-zinc-700/80 bg-black/60 px-4 py-3 text-white placeholder-zinc-500 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-500/20 transition text-sm"
          />

          <button
            type="submit"
            class="px-5 py-3 rounded-2xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-bold text-sm shadow-lg shadow-pink-600/20 transition hover:scale-105 active:scale-95 flex items-center gap-1.5 cursor-pointer"
          >
            <span>Send</span>
            <span>🚀</span>
          </button>
        </form>
      </div>

    </div>

    <!-- LEVEL-BASED BASKETBALL MINI-GAME MODAL -->
    <div id="basketball-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/90 backdrop-blur-2xl">
      <div class="relative w-full max-w-lg rounded-3xl border border-amber-500/40 bg-zinc-950 p-5 sm:p-6 text-center space-y-4 shadow-2xl shadow-amber-500/10 overflow-hidden">
        
        <!-- Close Button -->
        <button
          id="close-basketball-btn"
          type="button"
          class="absolute top-4 right-4 text-zinc-400 hover:text-white p-1 text-xl z-20 cursor-pointer"
        >
          ✖
        </button>

        <!-- Header Scoreboard & Level Pills -->
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold">
            🏆 Basketball Shootout • Level Progression
          </div>

          <!-- Level Selector Pills -->
          <div class="flex items-center justify-center gap-1.5 pt-1">
            {[1, 2, 3, 4, 5].map((lvl) => (
              <button
                type="button"
                class={`level-pill-btn px-3 py-1 rounded-full text-xs font-extrabold transition cursor-pointer ${
                  lvl === 1
                    ? "bg-amber-500 text-black shadow-md shadow-amber-500/30"
                    : "bg-zinc-900 text-zinc-500 border border-zinc-800 hover:border-zinc-700"
                }`}
                data-level={lvl}
              >
                Lvl {lvl}
              </button>
            ))}
          </div>

          <!-- Active Level Banner Description -->
          <div id="level-desc-banner" class="text-xs font-semibold text-amber-300 bg-amber-950/40 py-1.5 px-3 rounded-xl border border-amber-500/20">
            🔥 Level 1: Rookie Court (Fixed Rim • Target Score: 3)
          </div>
        </div>

        <!-- Score, Streak & Timer Bar -->
        <div class="flex items-center justify-between px-4 py-2 bg-zinc-900/80 rounded-2xl border border-zinc-800 text-xs font-bold text-zinc-200">
          <div class="flex items-center gap-1.5">
            <span class="text-amber-400">Score:</span>
            <span id="game-score" class="text-base text-white font-extrabold">0</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-pink-400">Streak:</span>
            <span id="game-streak" class="text-base text-white font-extrabold">0</span>
          </div>
          <div class="flex items-center gap-1 text-emerald-400">
            <span>Baskets:</span>
            <span id="game-baskets" class="font-extrabold text-white">0/3</span>
          </div>
          <div id="timer-box" class="hidden flex items-center gap-1 text-rose-400">
            <span>⏱️</span>
            <span id="timer-val" class="font-extrabold">15s</span>
          </div>
        </div>

        <!-- Basketball Court Area -->
        <div class="relative w-full h-[310px] rounded-2xl border border-zinc-800 bg-gradient-to-b from-indigo-950/60 via-zinc-950 to-amber-950/40 overflow-hidden flex flex-col justify-between p-4">
          
          <!-- Moving Backboard & Hoop Container -->
          <div id="hoop-container" class="relative w-full h-24 flex items-center justify-center transition-all duration-300">
            <div id="hoop-assembly" class="relative flex flex-col items-center transition-all duration-300">
              <!-- Backboard -->
              <div id="backboard" class="w-24 h-16 rounded-xl border-4 border-white/80 bg-white/10 backdrop-blur-md flex items-center justify-center shadow-lg transition-all duration-300">
                <div class="w-10 h-8 border-2 border-red-500/80 bg-red-500/10"></div>
              </div>
              <!-- Rim & Net -->
              <div class="relative -mt-1 flex flex-col items-center">
                <div id="rim" class="w-12 h-3.5 rounded-full border-4 border-amber-500 bg-amber-500/20 shadow-lg shadow-amber-500/50 transition-all duration-300"></div>
                <div class="w-9 h-7 border-x border-b border-dashed border-white/60 rounded-b-xl -mt-1 bg-white/5"></div>
              </div>
            </div>
          </div>

          <!-- Wind / Wave Indicator Banner -->
          <div id="wind-indicator" class="hidden absolute top-2 right-4 text-[11px] font-bold text-cyan-300 bg-cyan-950/60 px-2.5 py-1 rounded-full border border-cyan-500/30">
            💨 Wind: 8 mph Left
          </div>

          <!-- Swish Alert Overlay -->
          <div id="swish-alert" class="hidden absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2 font-extrabold text-3xl text-amber-400 animate-bounce drop-shadow-[0_0_15px_rgba(245,158,11,0.8)] z-30">
            🔥 SWISH!
          </div>

          <!-- Ball & Aiming Zone -->
          <div class="relative h-28 flex flex-col items-center justify-end">
            <!-- Aim Trajectory Line -->
            <div id="aim-line" class="w-1 bg-gradient-to-t from-amber-500 to-transparent h-16 mb-2 rounded-full opacity-70 transition-all duration-200"></div>
            
            <!-- Basketball Element -->
            <div
              id="basketball"
              class="w-14 h-14 rounded-full bg-gradient-to-tr from-amber-600 via-orange-500 to-amber-400 flex items-center justify-center text-2xl shadow-xl shadow-amber-500/30 border-2 border-amber-300 cursor-pointer transform hover:scale-110 active:scale-95 transition-all duration-100 z-20 select-none"
            >
              🏀
            </div>
          </div>

        </div>

        <!-- Controls Toolbar -->
        <div class="flex items-center justify-between gap-3 pt-1">
          <button
            id="shoot-btn"
            type="button"
            class="flex-1 py-3.5 rounded-full bg-gradient-to-r from-amber-500 via-orange-500 to-rose-600 hover:from-amber-400 hover:to-rose-500 text-white font-extrabold text-sm shadow-xl shadow-amber-500/25 transition hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
          >
            🏀 SHOOT (CLICK OR SWIPE)
          </button>
          
          <button
            id="share-score-btn"
            type="button"
            class="px-4 py-3.5 rounded-full border border-pink-500/40 bg-pink-500/10 hover:bg-pink-500/20 text-pink-300 font-bold text-xs transition cursor-pointer"
          >
            Post to Chat 💬
          </button>
        </div>

      </div>
    </div>

  </main>

  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const matchId = urlParams.get("matchId");

    const savedMatches = JSON.parse(localStorage.getItem("anonhearts_matches") || "[]");
    const activeMatch = savedMatches.find((m: any) => m.id === matchId) || {
      nickname: "VelvetEcho",
      avatar: "🦊",
      revealLevel: 35
    };

    const chatNickname = document.getElementById("chat-nickname");
    const chatAvatar = document.getElementById("chat-avatar");
    if (chatNickname) chatNickname.textContent = activeMatch.nickname;
    if (chatAvatar) chatAvatar.textContent = activeMatch.avatar;

    // Chat feed message helper
    const chatFeed = document.getElementById("chat-feed");
    function appendMessage(sender: "user" | "match" | "system", text: string) {
      if (!chatFeed) return;
      const wrap = document.createElement("div");

      if (sender === "user") {
        wrap.className = "flex items-end justify-end gap-2.5 max-w-[85%] sm:max-w-[70%] ml-auto animate-fade-in";
        wrap.innerHTML = `
          <div class="space-y-1 text-right">
            <div class="bg-gradient-to-r from-pink-600 to-rose-600 text-white p-3.5 rounded-2xl rounded-br-sm shadow-md">
              ${text}
            </div>
            <div class="text-[10px] text-zinc-500 px-1">Just now • Sent</div>
          </div>
        `;
      } else if (sender === "match") {
        wrap.className = "flex items-end gap-2.5 max-w-[85%] sm:max-w-[70%] animate-fade-in";
        wrap.innerHTML = `
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-pink-600 to-purple-800 flex items-center justify-center text-sm shrink-0">
            ${activeMatch.avatar}
          </div>
          <div class="space-y-1">
            <div class="bg-zinc-900 border border-zinc-800 p-3.5 rounded-2xl rounded-bl-sm text-zinc-200 shadow-md">
              ${text}
            </div>
            <div class="text-[10px] text-zinc-500 px-1">Just now</div>
          </div>
        `;
      } else {
        wrap.className = "text-center py-2 animate-fade-in";
        wrap.innerHTML = `
          <span class="inline-block px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300 font-semibold">
            ${text}
          </span>
        `;
      }

      chatFeed.appendChild(wrap);
      chatFeed.scrollTop = chatFeed.scrollHeight;
    }

    // Chat form submit
    const chatForm = document.getElementById("chat-form") as HTMLFormElement;
    const messageInput = document.getElementById("message-input") as HTMLInputElement;
    const typingIndicator = document.getElementById("typing-indicator");

    chatForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = messageInput.value.trim();
      if (!text) return;

      appendMessage("user", text);
      messageInput.value = "";

      setTimeout(() => typingIndicator?.classList.remove("hidden"), 500);
      setTimeout(() => {
        typingIndicator?.classList.add("hidden");
        const replies = [
          "Nice shot! Let's conquer Level 5 together 🏀",
          "You're a basketball legend!",
          "Swish! Keep aiming high 🔥"
        ];
        appendMessage("match", replies[Math.floor(Math.random() * replies.length)]);
      }, 1800);
    });

    // LEVEL-BASED GAME ENGINE LOGIC
    let currentLevel = 1;
    let score = 0;
    let streak = 0;
    let levelBaskets = 0;
    let isShooting = false;
    let timerInterval: any = null;
    let timeLeft = 15;

    const levelConfigs: Record<number, { title: string; target: number; accuracy: number; speed: number; wind: boolean; timer: boolean }> = {
      1: { title: "Level 1: Rookie Court (Fixed Rim • Target: 3)", target: 3, accuracy: 0.85, speed: 0, wind: false, timer: false },
      2: { title: "Level 2: Moving Rim (Horizontal Motion • Target: 3)", target: 3, accuracy: 0.70, speed: 1.5, wind: false, timer: false },
      3: { title: "Level 3: Crosswind Challenge (Wind Drift • Target: 4)", target: 4, accuracy: 0.55, speed: 2.5, wind: true, timer: false },
      4: { title: "Level 4: Sinusoidal Orbit (3D Motion • Target: 4)", target: 4, accuracy: 0.45, speed: 3.5, wind: true, timer: false },
      5: { title: "Level 5: Buzzer Beater Legend (15s Countdown! • Target: 5)", target: 5, accuracy: 0.35, speed: 4.5, wind: true, timer: true }
    };

    const basketModal = document.getElementById("basketball-modal");
    const playBasketBtn = document.getElementById("play-basketball-btn");
    const barBasketBtn = document.getElementById("bar-basketball-btn");
    const closeBasketBtn = document.getElementById("close-basketball-btn");
    const shootBtn = document.getElementById("shoot-btn");
    const basketball = document.getElementById("basketball");
    const swishAlert = document.getElementById("swish-alert");
    const shareScoreBtn = document.getElementById("share-score-btn");
    const levelDescBanner = document.getElementById("level-desc-banner");
    const windIndicator = document.getElementById("wind-indicator");

    const gameScoreEl = document.getElementById("game-score");
    const gameStreakEl = document.getElementById("game-streak");
    const gameBasketsEl = document.getElementById("game-baskets");
    const timerBox = document.getElementById("timer-box");
    const timerVal = document.getElementById("timer-val");

    const hoopAssembly = document.getElementById("hoop-assembly");
    const levelPillBtns = document.querySelectorAll(".level-pill-btn");

    function setLevel(lvl: number) {
      currentLevel = lvl;
      levelBaskets = 0;
      const config = levelConfigs[lvl];

      if (levelDescBanner) levelDescBanner.textContent = config.title;
      if (gameBasketsEl) gameBasketsEl.textContent = `0/${config.target}`;

      levelPillBtns.forEach((btn) => {
        const l = Number((btn as HTMLElement).dataset.level);
        if (l === lvl) {
          btn.className = "level-pill-btn px-3 py-1 rounded-full text-xs font-extrabold bg-amber-500 text-black shadow-md shadow-amber-500/30 cursor-pointer";
        } else {
          btn.className = "level-pill-btn px-3 py-1 rounded-full text-xs font-extrabold bg-zinc-900 text-zinc-400 border border-zinc-800 cursor-pointer hover:border-zinc-700";
        }
      });

      // Wind indicator
      if (config.wind && windIndicator) {
        windIndicator.classList.remove("hidden");
        windIndicator.textContent = `💨 Wind: ${Math.floor(Math.random() * 10 + 5)} mph Left`;
      } else {
        windIndicator?.classList.add("hidden");
      }

      // Timer box
      if (config.timer && timerBox) {
        timerBox.classList.remove("hidden");
        startTimer();
      } else {
        timerBox?.classList.add("hidden");
        clearInterval(timerInterval);
      }

      // Reset animation on hoop
      if (hoopAssembly) {
        hoopAssembly.style.animation = config.speed > 0 ? `slideHoop ${4 / config.speed}s ease-in-out infinite alternate` : "none";
      }
    }

    function startTimer() {
      clearInterval(timerInterval);
      timeLeft = 15;
      if (timerVal) timerVal.textContent = `${timeLeft}s`;

      timerInterval = setInterval(() => {
        timeLeft--;
        if (timerVal) timerVal.textContent = `${timeLeft}s`;
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          alert("⏱️ Time's Up on Level 5! Try again!");
          setLevel(5);
        }
      }, 1000);
    }

    function shootBall() {
      if (isShooting || !basketball) return;
      isShooting = true;

      const config = levelConfigs[currentLevel];
      basketball.style.transform = "translateY(-200px) scale(0.6)";

      const isSuccess = Math.random() < config.accuracy;

      setTimeout(() => {
        if (isSuccess) {
          score += (currentLevel * 10);
          streak++;
          levelBaskets++;

          if (swishAlert) {
            swishAlert.textContent = `🔥 Lvl ${currentLevel} SWISH! +${currentLevel * 5}% REVEAL`;
            swishAlert.classList.remove("hidden");
            setTimeout(() => swishAlert.classList.add("hidden"), 900);
          }

          // Check Level Completion
          if (levelBaskets >= config.target) {
            setTimeout(() => {
              if (currentLevel < 5) {
                alert(`🏆 LEVEL ${currentLevel} CONQUERED! Unlocking Level ${currentLevel + 1}! 🎉`);
                setLevel(currentLevel + 1);
              } else {
                alert("🏆 ALL 5 BASKETBALL LEVELS CONQUERED! LEGEND STATUS UNLOCKED! 🔥");
              }
            }, 300);
          }
        } else {
          streak = 0;
          basketball.style.transform = "translateY(-150px) translateX(45px) scale(0.5)";
        }

        if (gameScoreEl) gameScoreEl.textContent = String(score);
        if (gameStreakEl) gameStreakEl.textContent = String(streak);
        if (gameBasketsEl) gameBasketsEl.textContent = `${levelBaskets}/${config.target}`;

        setTimeout(() => {
          basketball.style.transform = "translateY(0) scale(1)";
          isShooting = false;
        }, 400);

      }, 400);
    }

    // Event listeners
    levelPillBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const lvl = Number((btn as HTMLElement).dataset.level);
        if (lvl) setLevel(lvl);
      });
    });

    playBasketBtn?.addEventListener("click", () => {
      basketModal?.classList.remove("hidden");
      setLevel(1);
    });
    barBasketBtn?.addEventListener("click", () => {
      basketModal?.classList.remove("hidden");
      setLevel(1);
    });
    closeBasketBtn?.addEventListener("click", () => {
      basketModal?.classList.add("hidden");
      clearInterval(timerInterval);
    });

    shootBtn?.addEventListener("click", shootBall);
    basketball?.addEventListener("click", shootBall);

    shareScoreBtn?.addEventListener("click", () => {
      basketModal?.classList.add("hidden");
      clearInterval(timerInterval);
      const scoreMsg = `🏀 Level ${currentLevel} Shootout Victory: Scored ${levelBaskets} Baskets (Total Points: ${score} pts) 🔥`;
      appendMessage("system", scoreMsg);
      setTimeout(() => {
        appendMessage("match", `Incredible score on Level ${currentLevel}! Let's play Level ${Math.min(5, currentLevel + 1)} next! 🏆`);
      }, 1200);
    });

    // Icebreaker click
    document.querySelectorAll(".icebreaker-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const text = (btn as HTMLElement).dataset.text;
        if (text && messageInput) {
          messageInput.value = text;
          messageInput.focus();
        }
      });
    });
  </script>
</Layout>

<style>
  @keyframes slideHoop {
    0% { transform: translateX(-90px); }
    100% { transform: translateX(90px); }
  }
</style>
