---
import Layout from "../layouts/Layout.astro";

const mockProfiles = [
  {
    id: "p1",
    nickname: "VelvetEcho",
    avatar: "🦊",
    avatarBg: "from-pink-600 to-purple-800",
    age: 23,
    distance: "3 miles away",
    compatibility: "96% Vibe Match",
    bio: "Late-night synthwave music producer & espresso addict. Looking for someone to trade Spotify playlists with at 2 AM.",
    interests: ["🎵 Music", "🎮 Gaming", "☕ Coffee & Tea", "🌌 Stargazing"],
    lookingFor: "Deep Relationship",
    revealLevel: 25
  },
  {
    id: "p2",
    nickname: "NeonDreamer",
    avatar: "🦉",
    avatarBg: "from-indigo-600 to-rose-700",
    age: 25,
    distance: "5 miles away",
    compatibility: "89% Vibe Match",
    bio: "Sci-fi fiction addict, amateur photographer, and weekend hiker. Let's talk about space exploration and plot twists.",
    interests: ["📚 Books", "📸 Photography", "✈️ Travel", "🎬 Movies"],
    lookingFor: "Dating & Vibe",
    revealLevel: 30
  },
  {
    id: "p3",
    nickname: "PixelHeart",
    avatar: "🐼",
    avatarBg: "from-emerald-600 to-teal-800",
    age: 22,
    distance: "2 miles away",
    compatibility: "94% Vibe Match",
    bio: "Indie game designer who bakes sourdough on Sundays. Tell me your absolute favorite video game storyline.",
    interests: ["🎮 Gaming", "🍳 Cooking", "🎨 Art", "💻 Coding"],
    lookingFor: "Someone to Chat With",
    revealLevel: 15
  },
  {
    id: "p4",
    nickname: "CosmicWhisper",
    avatar: "🐉",
    avatarBg: "from-amber-600 to-pink-700",
    age: 26,
    distance: "7 miles away",
    compatibility: "91% Vibe Match",
    bio: "Stargazer, poetry writer, and vinyl record collector. I believe the best connections start with zero expectations.",
    interests: ["🌌 Stargazing", "🎵 Music", "📚 Books", "☕ Coffee & Tea"],
    lookingFor: "Deep Relationship",
    revealLevel: 40
  },
  {
    id: "p5",
    nickname: "MidnightRider",
    avatar: "🐯",
    avatarBg: "from-purple-600 to-pink-600",
    age: 24,
    distance: "4 miles away",
    compatibility: "87% Vibe Match",
    bio: "Night owl, fitness enthusiast, and ramen connoisseur. Always down for spontaneous road trips.",
    interests: ["🏋️ Fitness", "✈️ Travel", "🎬 Movies", "🎵 Music"],
    lookingFor: "Casual Dating",
    revealLevel: 20
  }
];
---

<Layout title="Discover Matches — AnonHearts">
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex-1 flex flex-col justify-center w-full max-w-full overflow-x-hidden">

    <!-- Top Action Bar -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2">
          <span>Discover Vibe Matches</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-pink-500/20 text-pink-300 border border-pink-500/30">
            Live Queue
          </span>
        </h1>
        <p class="text-xs sm:text-sm text-zinc-400">Purely anonymous profiles filtered by your passions</p>
      </div>

      <button
        id="filter-btn"
        type="button"
        class="flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-800 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-300 text-xs sm:text-sm font-semibold transition cursor-pointer"
      >
        <span>⚡ Filter Vibe</span>
      </button>
    </div>

    <!-- MAIN DISCOVER CARD CONTAINER -->
    <div class="relative w-full max-w-lg mx-auto min-h-[520px] sm:min-h-[560px] flex items-center justify-center">

      <!-- Profile Stack Container -->
      <div id="card-container" class="relative w-full h-[500px] sm:h-[540px]">
        {mockProfiles.map((p, index) => (
          <div
            class="profile-card absolute inset-0 rounded-[2.5rem] border border-zinc-800/90 bg-zinc-950 shadow-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 transform select-none"
            data-id={p.id}
            data-nickname={p.nickname}
            data-avatar={p.avatar}
            style={`z-index: ${mockProfiles.length - index}; transform: translateY(${index * 8}px) scale(${1 - index * 0.04}); opacity: ${index > 2 ? 0 : 1};`}
          >
            <!-- Card Background Avatar Art Header -->
            <div class={`relative h-48 sm:h-56 bg-gradient-to-tr ${p.avatarBg} p-5 sm:p-6 flex flex-col justify-between overflow-hidden`}>
              <div class="absolute -right-6 -bottom-6 text-9xl opacity-20 filter blur-sm">
                {p.avatar}
              </div>

              <!-- Top Badges -->
              <div class="flex items-center justify-between relative z-10">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-xs font-semibold text-white">
                  <span>🔒</span>
                  <span>100% Anonymous</span>
                </span>

                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-pink-500/80 backdrop-blur-md text-xs font-bold text-white shadow-lg">
                  <span>⚡</span> {p.compatibility}
                </span>
              </div>

              <!-- Center Big Avatar -->
              <div class="self-center relative z-10 transform hover:scale-110 transition duration-300">
                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-black/40 backdrop-blur-md border-2 border-white/20 flex items-center justify-center text-4xl sm:text-5xl shadow-2xl">
                  {p.avatar}
                </div>
              </div>

              <!-- Identity Reveal Bar -->
              <div class="relative z-10 bg-black/50 backdrop-blur-md p-2 rounded-xl border border-white/10 space-y-1">
                <div class="flex justify-between text-[11px] font-semibold text-zinc-200">
                  <span>Identity Mask Status</span>
                  <span class="text-pink-300">{p.revealLevel}% Unlocked</span>
                </div>
                <div class="w-full bg-zinc-800/80 h-1.5 rounded-full overflow-hidden">
                  <div class="bg-gradient-to-r from-pink-500 to-rose-400 h-full rounded-full" style={`width: ${p.revealLevel}%;`}></div>
                </div>
              </div>
            </div>

            <!-- Profile Content Body -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-3 sm:space-y-4 bg-zinc-950">
              <div>
                <div class="flex items-baseline justify-between">
                  <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight flex items-center gap-2">
                    <span>{p.nickname}</span>
                    <span class="text-base sm:text-lg text-zinc-400 font-normal">, {p.age}</span>
                  </h2>
                  <span class="text-xs text-zinc-500 font-medium">📍 {p.distance}</span>
                </div>
                <p class="text-xs text-pink-400 font-medium mt-0.5">Looking for: {p.lookingFor}</p>
              </div>

              <!-- Bio -->
              <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed italic bg-zinc-900/60 p-3 rounded-2xl border border-zinc-800/60">
                "{p.bio}"
              </p>

              <!-- Interest Tags -->
              <div>
                <span class="text-[10px] sm:text-[11px] font-semibold uppercase text-zinc-500 tracking-wider">Passions & Interests</span>
                <div class="flex flex-wrap gap-1.5 mt-1.5">
                  {p.interests.map((tag) => (
                    <span class="px-2.5 py-1 rounded-full border border-pink-500/20 bg-pink-500/10 text-pink-300 text-[11px] font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

          </div>
        ))}

        <!-- Empty Queue State -->
        <div id="empty-state" class="hidden absolute inset-0 rounded-[2.5rem] border border-zinc-800 bg-zinc-950 p-8 text-center flex flex-col items-center justify-center space-y-4">
          <div class="w-20 h-20 rounded-full bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-4xl">
            ✨
          </div>
          <h3 class="text-2xl font-bold text-white">You've seen all local profiles!</h3>
          <p class="text-sm text-zinc-400 max-w-xs">Check back soon for new anonymous singles or adjust your vibe filter.</p>
          <button
            id="reset-queue-btn"
            class="px-6 py-3 rounded-full bg-gradient-to-r from-pink-600 to-rose-600 text-white font-bold text-sm shadow-lg shadow-pink-500/20 cursor-pointer"
          >
            Reload Queue ❤️
          </button>
        </div>

      </div>

    </div>

    <!-- ACTION CONTROL TOOLBAR -->
    <div class="mt-8 flex items-center justify-center gap-4 sm:gap-6">

      <!-- PASS BUTTON -->
      <button
        id="pass-btn"
        type="button"
        class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border border-zinc-800 bg-zinc-900/90 text-red-400 hover:text-red-300 hover:border-red-500/40 hover:bg-red-500/10 flex items-center justify-center text-2xl shadow-xl transition transform hover:scale-110 active:scale-95 cursor-pointer"
        title="Pass Profile"
      >
        ✖
      </button>

      <!-- SUPER LIKE -->
      <button
        id="super-btn"
        type="button"
        class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border border-zinc-800 bg-zinc-900/90 text-amber-400 hover:text-amber-300 hover:border-amber-500/40 hover:bg-amber-500/10 flex items-center justify-center text-xl shadow-xl transition transform hover:scale-110 active:scale-95 cursor-pointer"
        title="Super Heart"
      >
        ⭐
      </button>

      <!-- LIKE / MATCH BUTTON -->
      <button
        id="like-btn"
        type="button"
        class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-tr from-pink-600 to-rose-500 text-white flex items-center justify-center text-3xl shadow-2xl shadow-pink-600/40 hover:shadow-pink-600/60 transition transform hover:scale-110 active:scale-95 cursor-pointer"
        title="Send Heart"
      >
        ❤️
      </button>

      <!-- SPARK DIRECT CHAT -->
      <button
        id="spark-btn"
        type="button"
        class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border border-zinc-800 bg-zinc-900/90 text-purple-400 hover:text-purple-300 hover:border-purple-500/40 hover:bg-purple-500/10 flex items-center justify-center text-xl shadow-xl transition transform hover:scale-110 active:scale-95 cursor-pointer"
        title="Instant Anonymous Spark"
      >
        ⚡
      </button>

    </div>

    <!-- MUTUAL MATCH CELEBRATION MODAL (CENTERED PERFECTLY ON MOBILE) -->
    <div id="match-modal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-3 sm:p-4 bg-black/90 backdrop-blur-2xl overflow-y-auto w-full h-full">
      <div class="w-[92%] sm:w-full max-w-sm sm:max-w-md rounded-3xl border border-pink-500/40 bg-gradient-to-b from-zinc-950 via-zinc-900 to-pink-950 p-6 sm:p-8 text-center space-y-5 shadow-2xl shadow-pink-500/30 mx-auto my-auto relative">
        
        <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-pink-500/20 border-2 border-pink-500/50 text-3xl sm:text-4xl animate-bounce">
          💘
        </div>

        <div class="space-y-1.5">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">IT'S A MUTUAL MATCH!</h3>
          <p class="text-xs sm:text-sm text-pink-300 font-medium">
            You and <span id="match-nickname" class="text-white font-bold">VelvetEcho</span> both sent hearts!
          </p>
        </div>

        <!-- Clashing Avatars -->
        <div class="flex items-center justify-center gap-3 sm:gap-4 py-2 sm:py-4">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-pink-600 to-purple-600 flex items-center justify-center text-2xl sm:text-3xl shadow-lg border-2 border-pink-400">
            🦊
          </div>
          <span class="text-xl sm:text-2xl text-pink-500 font-bold">⚡</span>
          <div id="match-target-avatar" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-indigo-600 to-rose-600 flex items-center justify-center text-2xl sm:text-3xl shadow-lg border-2 border-pink-400">
            🦉
          </div>
        </div>

        <p class="text-[11px] sm:text-xs text-zinc-400">
          Your identity level starts at 25%. Send messages to unmask clues!
        </p>

        <div class="space-y-2.5 pt-2">
          <a
            id="start-chat-link"
            href="/chat"
            class="w-full py-3.5 rounded-full bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-bold text-xs sm:text-sm shadow-xl shadow-pink-500/30 flex items-center justify-center gap-2"
          >
            <span>Start Anonymous Chat Now</span>
            <span>💬</span>
          </a>
          <button
            id="close-match-btn"
            type="button"
            class="w-full py-2.5 rounded-full text-xs text-zinc-400 hover:text-white font-medium cursor-pointer"
          >
            Keep Swiping
          </button>
        </div>

      </div>
    </div>

  </main>

  <script>
    let currentIndex = 0;
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".profile-card"));
    const emptyState = document.getElementById("empty-state");
    const matchModal = document.getElementById("match-modal");
    const matchNickname = document.getElementById("match-nickname");
    const matchTargetAvatar = document.getElementById("match-target-avatar");
    const startChatLink = document.getElementById("start-chat-link");
    const closeMatchBtn = document.getElementById("close-match-btn");

    function updateCardStack() {
      cards.forEach((card, idx) => {
        const offset = idx - currentIndex;
        if (offset < 0) {
          card.style.transform = "translateX(-150%) rotate(-20deg)";
          card.style.opacity = "0";
          card.style.pointerEvents = "none";
        } else if (offset === 0) {
          card.style.transform = "translateY(0) scale(1)";
          card.style.opacity = "1";
          card.style.pointerEvents = "auto";
        } else if (offset === 1) {
          card.style.transform = "translateY(8px) scale(0.96)";
          card.style.opacity = "1";
          card.style.pointerEvents = "none";
        } else if (offset === 2) {
          card.style.transform = "translateY(16px) scale(0.92)";
          card.style.opacity = "0.7";
          card.style.pointerEvents = "none";
        } else {
          card.style.transform = "translateY(24px) scale(0.88)";
          card.style.opacity = "0";
          card.style.pointerEvents = "none";
        }
      });

      if (currentIndex >= cards.length) {
        emptyState?.classList.remove("hidden");
      }
    }

    function swipeCard(action: "like" | "pass" | "super" | "spark") {
      if (currentIndex >= cards.length) return;

      const card = cards[currentIndex];
      const nickname = card.dataset.nickname || "MysteryMatch";
      const avatar = card.dataset.avatar || "🦊";
      const matchId = card.dataset.id || "p1";

      if (action === "like" || action === "super" || action === "spark") {
        card.style.transform = "translateX(150%) rotate(20deg)";
        card.style.opacity = "0";

        // Save match to local storage state
        const existingMatches = JSON.parse(localStorage.getItem("anonhearts_matches") || "[]");
        if (!existingMatches.some((m: any) => m.id === matchId)) {
          existingMatches.push({
            id: matchId,
            nickname,
            avatar,
            revealLevel: action === "spark" ? 40 : 25,
            lastMessage: "You matched! Say hi anonymously 👋",
            timestamp: "Just now"
          });
          localStorage.setItem("anonhearts_matches", JSON.stringify(existingMatches));
        }

        // Show celebration popup
        setTimeout(() => {
          if (matchNickname) matchNickname.textContent = nickname;
          if (matchTargetAvatar) matchTargetAvatar.textContent = avatar;
          if (startChatLink) startChatLink.setAttribute("href", `/chat?matchId=${matchId}`);
          matchModal?.classList.remove("hidden");
        }, 200);

      } else {
        card.style.transform = "translateX(-150%) rotate(-20deg)";
        card.style.opacity = "0";
      }

      currentIndex++;
      setTimeout(updateCardStack, 250);
    }

    document.getElementById("pass-btn")?.addEventListener("click", () => swipeCard("pass"));
    document.getElementById("like-btn")?.addEventListener("click", () => swipeCard("like"));
    document.getElementById("super-btn")?.addEventListener("click", () => swipeCard("super"));
    document.getElementById("spark-btn")?.addEventListener("click", () => swipeCard("spark"));

    closeMatchBtn?.addEventListener("click", () => {
      matchModal?.classList.add("hidden");
    });

    document.getElementById("reset-queue-btn")?.addEventListener("click", () => {
      currentIndex = 0;
      emptyState?.classList.add("hidden");
      updateCardStack();
    });

    updateCardStack();
  </script>
</Layout>
