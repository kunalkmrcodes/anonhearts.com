---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Account Settings & Privacy — AnonHearts">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-10 flex-1">

    <!-- Header -->
    <div class="mb-10 space-y-2">
      <h1 class="text-3xl font-extrabold text-white tracking-tight flex items-center gap-3">
        <span>Settings & Privacy Controls</span>
        <span class="text-xl">⚙️</span>
      </h1>
      <p class="text-zinc-400 text-sm">
        Manage your anonymous profile visibility, safety preferences, and account controls.
      </p>
    </div>

    <div class="space-y-8">

      <!-- SECTION 1: PRIVACY & SAFETY -->
      <section class="rounded-3xl border border-zinc-800/80 bg-zinc-950/80 p-6 sm:p-8 backdrop-blur-xl space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2 border-b border-zinc-800/80 pb-4">
          <span>🔒</span>
          <span>Privacy & Incognito Mode</span>
        </h2>

        <div class="space-y-6">
          
          <!-- Ghost Mode -->
          <div class="flex items-center justify-between gap-4">
            <div>
              <h3 class="text-sm font-semibold text-white">Ghost Mode (Incognito)</h3>
              <p class="text-xs text-zinc-400">Only people you like first can see your profile card in Discover.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer" />
              <div class="w-11 h-6 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-600"></div>
            </label>
          </div>

          <!-- Hide Online Status -->
          <div class="flex items-center justify-between gap-4">
            <div>
              <h3 class="text-sm font-semibold text-white">Hide Online Badge</h3>
              <p class="text-xs text-zinc-400">Don't show active status indicators to active matches.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer" />
              <div class="w-11 h-6 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-600"></div>
            </label>
          </div>

          <!-- Pause Matching -->
          <div class="flex items-center justify-between gap-4">
            <div>
              <h3 class="text-sm font-semibold text-white">Pause Profile Card</h3>
              <p class="text-xs text-zinc-400">Temporarily hide profile from discovery queue while keeping active chats.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer" />
              <div class="w-11 h-6 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-600"></div>
            </label>
          </div>

        </div>
      </section>

      <!-- SECTION 2: MATCHING PREFERENCES -->
      <section class="rounded-3xl border border-zinc-800/80 bg-zinc-950/80 p-6 sm:p-8 backdrop-blur-xl space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2 border-b border-zinc-800/80 pb-4">
          <span>🎯</span>
          <span>Discovery & Vibe Preferences</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

          <!-- Distance Radius -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs font-semibold text-zinc-300">
              <span>Maximum Distance</span>
              <span id="dist-val" class="text-pink-400 font-bold">25 miles</span>
            </div>
            <input
              id="dist-slider"
              type="range"
              min="5"
              max="100"
              value="25"
              class="w-full accent-pink-500 h-2 bg-zinc-800 rounded-lg cursor-pointer"
            />
          </div>

          <!-- Age Range -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs font-semibold text-zinc-300">
              <span>Preferred Age Range</span>
              <span class="text-pink-400 font-bold">18 — 35</span>
            </div>
            <div class="flex items-center gap-3">
              <input type="number" min="18" max="99" value="18" class="w-full rounded-xl bg-black border border-zinc-700 px-3 py-2 text-white text-xs" />
              <span class="text-zinc-500 text-xs">to</span>
              <input type="number" min="18" max="99" value="35" class="w-full rounded-xl bg-black border border-zinc-700 px-3 py-2 text-white text-xs" />
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 3: ACCOUNT & LOGOUT -->
      <section class="rounded-3xl border border-zinc-800/80 bg-zinc-950/80 p-6 sm:p-8 backdrop-blur-xl space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2 border-b border-zinc-800/80 pb-4">
          <span>⚙️</span>
          <span>Account Controls</span>
        </h2>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold text-white">Logged in session</h3>
            <p id="user-email-text" class="text-xs text-zinc-400">demo@anonhearts.com</p>
          </div>

          <div class="flex items-center gap-3">
            <button
              id="logout-btn"
              type="button"
              class="px-6 py-2.5 rounded-full border border-red-500/40 bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-bold transition"
            >
              Sign Out 🚪
            </button>
          </div>
        </div>
      </section>

    </div>
  </main>

  <script>
    import { supabase } from "../lib/supabase";

    // Display user email from session
    const userSession = JSON.parse(localStorage.getItem("anonhearts_user") || "{}");
    const emailText = document.getElementById("user-email-text");
    if (emailText && userSession.email) {
      emailText.textContent = userSession.email;
    }

    // Slider
    const distSlider = document.getElementById("dist-slider") as HTMLInputElement;
    const distVal = document.getElementById("dist-val");
    distSlider?.addEventListener("input", (e) => {
      if (distVal) distVal.textContent = `${(e.target as HTMLInputElement).value} miles`;
    });

    // Logout
    const logoutBtn = document.getElementById("logout-btn");
    logoutBtn?.addEventListener("click", async () => {
      try {
        await supabase.auth.signOut();
      } catch (e) {
        console.warn("Signout session reset:", e);
      }
      localStorage.removeItem("anonhearts_user");
      window.location.href = "/";
    });
  </script>
</Layout>
