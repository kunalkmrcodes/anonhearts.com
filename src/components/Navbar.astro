---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: "Discover", href: "/discover", icon: "🔥" },
  { name: "Matches & Chat", href: "/matches", icon: "💬" },
  { name: "Profile", href: "/profile", icon: "👤" },
  { name: "Settings", href: "/settings", icon: "⚙️" },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-pink-600 to-rose-400 flex items-center justify-center text-xl shadow-lg shadow-pink-500/20 group-hover:scale-105 transition duration-300">
          ❤️
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-lg tracking-tight text-white group-hover:text-pink-400 transition">
            AnonHearts
          </span>
          <span class="text-[10px] text-pink-400/80 font-medium -mt-1 tracking-wider uppercase">
            Anonymous Dating
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1.5 bg-zinc-900/60 p-1.5 rounded-full border border-zinc-800/60">
        {navItems.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium transition duration-200 ${
                isActive
                  ? "bg-gradient-to-r from-pink-600 to-rose-600 text-white shadow-md shadow-pink-500/20"
                  : "text-zinc-400 hover:text-white hover:bg-zinc-800/60"
              }`}
            >
              <span>{item.icon}</span>
              <span>{item.name}</span>
            </a>
          );
        })}
      </nav>

      <!-- Auth Action / User Quick Menu -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/login"
          class="px-4 py-2 text-sm font-medium text-zinc-300 hover:text-white transition"
        >
          Login
        </a>
        <a
          href="/signup"
          class="px-5 py-2 text-sm font-semibold text-white bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 rounded-full shadow-lg shadow-pink-500/20 hover:shadow-pink-500/30 transition hover:scale-105 active:scale-95"
        >
          Get Started
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-800 focus:outline-none"
          aria-label="Toggle menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-zinc-800 bg-zinc-950 px-4 pt-3 pb-6 space-y-2">
    {navItems.map((item) => {
      const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`flex items-center gap-3 px-4 py-3 rounded-2xl text-base font-medium transition ${
            isActive
              ? "bg-pink-600/20 text-pink-400 border border-pink-500/30"
              : "text-zinc-400 hover:bg-zinc-900 hover:text-white"
          }`}
        >
          <span class="text-xl">{item.icon}</span>
          <span>{item.name}</span>
        </a>
      );
    })}
    <div class="pt-4 border-t border-zinc-800/80 flex flex-col gap-2.5">
      <a
        href="/login"
        class="w-full text-center py-2.5 rounded-full border border-zinc-700 font-medium text-zinc-300 hover:bg-zinc-900"
      >
        Login
      </a>
      <a
        href="/signup"
        class="w-full text-center py-2.5 rounded-full bg-gradient-to-r from-pink-600 to-rose-600 font-semibold text-white shadow-lg shadow-pink-500/20"
      >
        Get Started ❤️
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
