---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
}

const {
  title = "AnonHearts — Anonymous Dating & Authentic Connections",
  description = "Meet people anonymously based on real personality and shared interests. Reveal identity only when you build trust.",
  hideNav = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <style>
      body {
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>
  </head>

  <body class="bg-black text-zinc-100 min-h-screen flex flex-col selection:bg-pink-500 selection:text-white relative overflow-x-hidden antialiased">
    <!-- Ambient Background Glow Effects -->
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div class="absolute -top-40 left-1/4 h-96 w-96 rounded-full bg-pink-600/10 blur-[120px]"></div>
      <div class="absolute top-1/3 -right-40 h-96 w-96 rounded-full bg-rose-600/10 blur-[120px]"></div>
      <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-purple-600/10 blur-[120px]"></div>
    </div>

    {!hideNav && <Navbar />}

    <div class="relative z-10 flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Global Footer -->
    <footer class="relative z-10 border-t border-zinc-900 bg-zinc-950/80 py-8 px-6 text-center text-xs text-zinc-500">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© 2026 AnonHearts. Privacy-first anonymous connection platform.</p>
        <div class="flex items-center gap-6">
          <a href="#" class="hover:text-pink-400 transition">Privacy Policy</a>
          <a href="#" class="hover:text-pink-400 transition">Terms of Service</a>
          <a href="#" class="hover:text-pink-400 transition">Safety Guidelines</a>
        </div>
      </div>
    </footer>
  </body>
</html>